# PostgreSQL connection; DATABASE_URL is preferred over the individual DB_* values.
DATABASE_URL=postgres://user:password@localhost:5432/hogona_crawl

# Serper Places API key. Keep the actual value only in .env.
SERPER_API_KEY=replace-with-your-key

# Optional: Google Drive for Desktop's synced Hogona folder. Without this,
# Drive batches use tmp/drive-sync/Hogona Enrichment for local testing.
DRIVE_SYNC_ROOT=G:\\My Drive\\Hogona Enrichment
